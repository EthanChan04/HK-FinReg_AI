# ===========================
# HK-FinReg AI Backend — 環境變量模板
# ===========================
# 複製此文件為 .env 並填入真實值：
#   cp .env.example .env

# ----- Explicit DeepSeek V4 Flash Runtime -----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_INTERACTIVE_THINKING=False
DEEPSEEK_REASONING_THINKING=True

# Embeddings are deliberately local and independent from the chat model.
# EMBEDDING_PROVIDER:
#   - local_hash: local deterministic default (no external API)
#   - openai_compatible: optional external embedding endpoint
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=local-hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256
COPILOT_MAX_CONTEXT_CHARS=16000
COPILOT_MAX_HISTORY_MESSAGES=8

# ----- Cohere Reranker -----
# 註冊：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key

# ----- LangSmith 全鏈路追蹤 -----
# 註冊：https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Fintech-PoC-Backend

# ===== Security (重要：生產環境務必啟用) =====
# 設為 True 並配置 API_KEY 後，所有業務端點需攜帶 Authorization: Bearer <key>
# 生產環境必須設為 True，否則任何人都可以無限制調用 LLM API（成本風險）
# 生成強密鑰：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ENABLED=True
API_KEY=change_me_to_a_strong_random_key

# ----- Rate Limiting -----
# 防止 API 濫用和 LLM 調用成本失控
RATE_LIMIT_RPM=60           # 每分鐘最大請求數
RATE_LIMIT_RPH=500          # 每小時最大請求數
RATE_LIMIT_STORAGE_URL=     # Redis URL for multi-replica deployments
TRUSTED_PROXY_HEADERS=False # Only enable behind a trusted proxy chain

# ----- App Mode -----
# 設為 True 開啟 Swagger 文檔 (/docs, /redoc) 和測試客戶端 (/test)
# 生產環境必須設為 False
DEBUG=False

# ----- CORS (生產環境請替換為實際前端域名) -----
# 生產環境必須配置為實際前端域名，禁止使用 * 通配符
# CORS_ORIGINS=https://your-production-domain.com

# ----- SIRA-style Query Planning + Experience-RAG Strategy Memory -----
# Disabled by default for production safety; enable gradually in staging first.
SIRA_QUERY_PLANNER_ENABLED=False
SIRA_TERM_STATS_PATH=data/indexes/term_statistics.json
EXPERIENCE_RAG_ENABLED=False
EXPERIENCE_RAG_MEMORY_PATH=data/strategy_memory/retrieval_experiences.jsonl
EXPERIENCE_RAG_RECORDING_ENABLED=False
EXPERIENCE_RAG_MAX_RECORDS=1000

