# ===========================
# HK-FinReg AI Backend — 環境變量模板
# ===========================
# 複製此文件為 .env 並填入真實值：
#   cp .env.example .env

# ----- LLM API Keys (MiMo-v2.5 via OpenAI-compatible endpoint) -----
ZHIPU_API_KEY=your_mimo_api_key
LONGCAT_API_KEY=your_mimo_api_key

# ----- MiMo-v2.5 Model Endpoint -----
ZHIPU_MODEL=MiMo-v2.5
LONGCAT_MODEL=MiMo-v2.5
ZHIPU_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LONGCAT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
ZHIPU_EMBEDDING_MODEL=embedding-3
# Embedding config (decoupled from chat model endpoint)
# EMBEDDING_PROVIDER:
#   - openai_compatible: call {EMBEDDING_BASE_URL}/embeddings with EMBEDDING_MODEL
#   - local_hash: local deterministic fallback (no external API)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=256
COPILOT_MODEL=MiMo-v2.5
COPILOT_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
COPILOT_API_KEY=
COPILOT_TIMEOUT_SECONDS=60
COPILOT_MAX_CONTEXT_CHARS=16000
COPILOT_MAX_HISTORY_MESSAGES=8

# ----- Cohere Reranker -----
# 註冊：https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key

# ----- LangSmith 全鏈路追蹤 -----
# 註冊：https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=Fintech-PoC-Backend

# ----- Security (重要：生產環境務必啟用) -----
# 設為 True 並配置 API_KEY 後，所有業務端點需攜帶 Authorization: Bearer <key>
# 生產環境必須設為 True，否則任何人都可以無限制調用 LLM API（成本風險）
API_KEY_ENABLED=True
API_KEY=change_me_to_a_strong_random_key

# ----- App Mode -----
# 設為 True 開啟 Swagger 文檔 (/docs, /redoc) 和測試客戶端 (/test)
DEBUG=False

# ----- CORS (生產環境請替換為實際前端域名) -----
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

